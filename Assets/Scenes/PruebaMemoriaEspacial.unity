  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d9f1e6455b9a2ad4c97af8f5111707f9, type: 3}
    m_FontSize: 34
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.15
  m_Text: "1.  Observa c\xF3mo se iluminan los cristales <color=#4DA6FF>AZUL</color>,
    <color=#4DFF88>VERDE</color> y <color=#FF9A33>NARANJA</color>. Cada uno tiene
    su propio sonido.\n2.  Repite la secuencia haciendo clic en los cristales, en
    el mismo orden.\n3.  Si aciertas, pasas al siguiente nivel: la secuencia es m\xE1s
    larga y m\xE1s r\xE1pida.\n4.  Si te equivocas, pierdes una oportunidad. Tienes
    <color=#FF5A66>3 oportunidades</color>.\n5.  Supera el <b>nivel 10</b> para aprobar
    la prueba."
